// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./warshati.db"
}

// ─────────────────────────────────────────
// LICENSING (LOCAL SYSTEM CACHE)
// ─────────────────────────────────────────
model LocalLicense {
  id          String   @id @default(cuid())
  key         String   @unique
  machineId   String
  activatedAt DateTime @default(now())
  lastValidatedAt DateTime? // last successful online check; drives the offline grace period
  plan        Int      @default(1) // 1 lifetime, 2 cloud + mobile, 3 VIP (everything, e.g. shop network)
}

// ─────────────────────────────────────────
// DEVICE CATALOG (bundled list + devices the shop typed by hand)
// ─────────────────────────────────────────
model DeviceCatalog {
  id        String   @id @default(cuid())
  category  String   // PHONE | LAPTOP | CONSOLE
  brand     String
  model     String
  specs     String   @default("{}") // JSON
  imageUrl  String?  // where the image can be downloaded from
  imageFile String?  // downloaded image, relative to the catalog images folder
  isCustom  Boolean  @default(false) // typed by hand in this shop; never replaced by catalog updates
  createdAt DateTime @default(now())

  @@unique([category, brand, model])
  @@index([category, brand])
}

// Accessory catalog (assets/catalog/accessories.json): picked when adding stock; its price is only a suggestion
model AccessoryCatalog {
  id        String   @id @default(cuid())
  name      String   @unique
  category  String   // PACK | CASE | SCREEN | CHARGER | CABLE | ADAPTER | POWER_BANK | AUDIO | HOLDER | WATCH | GAMING | STORAGE | CAMERA | OTHER
  price     Int?     // market price, suggested when adding to inventory
  oldPrice  Int?
  imageUrl  String?
  imageFile String?  // downloaded photo, relative to the catalog images folder
  createdAt DateTime @default(now())

  @@index([category])
}

// Small key/value settings (e.g. installed catalog version)
model AppMeta {
  key   String @id
  value String
}

// ─────────────────────────────────────────
// STORE & AUTH
// ─────────────────────────────────────────

model Store {
  id           String   @id @default(cuid())
  name         String
  phone        String?
  address      String?
  currency     String   @default("DZD")
  warrantyDays Int      @default(5)
  logoPath     String?
  createdAt    DateTime @default(now())

  // Optional features (Settings → Store → Features)
  featCheckIn         Boolean @default(true)  // the Check-in page (quick drop-off slip before the ticket)
  featDeliveryReceipt Boolean @default(true)  // offer a delivery receipt when a repair is handed back
  featQuickCash       Boolean @default(true)  // POS: bill buttons that fill the amount paid
  featDrawerFloat     Boolean @default(false) // the drawer starts each day with a fixed amount
  drawerFloat         Int     @default(0)
  featRepairmen       Boolean @default(false) // repairs can be given to a repairman paid per repair
}

// Repairman (engineer) paid per repair: % of the profit (price − parts), % of the price, or a fixed amount
model Repairman {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  payType   String   @default("PROFIT_PERCENT") // PROFIT_PERCENT | PRICE_PERCENT | FIXED
  payValue  Decimal  @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tickets   RepairTicket[]
  payments  RepairmanPayment[]
}

// Money the owner handed to a repairman (leaves the drawer on that day)
model RepairmanPayment {
  id          String    @id @default(cuid())
  repairmanId String
  repairman   Repairman @relation(fields: [repairmanId], references: [id])
  amount      Decimal
  notes       String?
  paidAt      DateTime  @default(now())

  @@index([paidAt])
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(STAFF)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  checkIns     CheckIn[]
  tickets      RepairTicket[]
  sales        Sale[]
  expenses     Expense[]
  refunds      Refund[]
}

enum Role {
  OWNER
  STAFF
}

// ─────────────────────────────────────────
// CUSTOMERS
// ─────────────────────────────────────────

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  notes     String?
  createdAt DateTime @default(now())

  checkIns      CheckIn[]
  repairTickets RepairTicket[]
  sales         Sale[]
  tradeIns      TradeIn[]
  debtLedger    DebtEntry[]

  @@index([phone])
}

// ─────────────────────────────────────────
// CUSTOMER DEBT LEDGER
// ─────────────────────────────────────────

enum DebtType {
  REPAIR_CREDIT
  SALE_CREDIT
  PARTIAL_PAYMENT
  OPENING_BALANCE // owed before the shop started using Warshati (entered by hand)
}

enum DebtStatus {
  OPEN
  PARTIAL
  SETTLED
}

model DebtEntry {
  id           String     @id @default(cuid())
  customerId   String
  customer     Customer   @relation(fields: [customerId], references: [id])

  type         DebtType
  totalAmount  Decimal
  paidAmount   Decimal    @default(0)
  remaining    Decimal
  status       DebtStatus @default(OPEN)

  saleId         String?  @unique
  sale           Sale?    @relation(fields: [saleId], references: [id])
  repairTicketId String?  @unique
  repairTicket   RepairTicket? @relation(fields: [repairTicketId], references: [id])

  payments     DebtPayment[]
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([status])
  @@index([customerId])
}

model DebtPayment {
  id          String    @id @default(cuid())
  debtEntryId String
  debtEntry   DebtEntry @relation(fields: [debtEntryId], references: [id])
  amount      Decimal   // negative for a cancelling entry
  paidAt      DateTime  @default(now())
  notes       String?
  reversalOf  String?   // id of the payment this entry cancels
}

// ─────────────────────────────────────────
// SUPPLIERS
// ─────────────────────────────────────────

model Supplier {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  address   String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  purchaseOrders PurchaseOrder[]
  supplierDebts  SupplierDebt[]
}

model PurchaseOrder {
  id           String        @id @default(cuid())
  orderNumber  String        @unique
  supplierId   String
  supplier     Supplier      @relation(fields: [supplierId], references: [id])

  totalAmount  Decimal
  paidAmount   Decimal       @default(0)
  paymentStatus PaymentStatus @default(UNPAID)

  items        PurchaseOrderItem[]
  supplierDebt SupplierDebt?

  notes        String?
  orderedAt    DateTime      @default(now())
  receivedAt   DateTime?
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])

  quantity        Int
  unitCost        Decimal
  subtotal        Decimal
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

model SupplierDebt {
  id              String        @id @default(cuid())
  supplierId      String
  supplier        Supplier      @relation(fields: [supplierId], references: [id])

  purchaseOrderId String        @unique
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  totalAmount     Decimal
  paidAmount      Decimal       @default(0)
  remaining       Decimal
  status          DebtStatus    @default(OPEN)

  payments        SupplierDebtPayment[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model SupplierDebtPayment {
  id             String       @id @default(cuid())
  supplierDebtId String
  supplierDebt   SupplierDebt @relation(fields: [supplierDebtId], references: [id])
  amount         Decimal      // negative for a cancelling entry
  paidAt         DateTime     @default(now())
  notes          String?
  reversalOf     String?      // id of the payment this entry cancels
}

// ─────────────────────────────────────────
// INVENTORY
// ─────────────────────────────────────────

enum InventoryType {
  PHONE_NEW
  PHONE_USED
  PART
  ACCESSORY
}

model InventoryItem {
  id          String        @id @default(cuid())
  type        InventoryType
  name        String
  sku         String?       @unique
  barcode     String?       @unique
  imei        String?       @unique
  brand       String?
  model       String?
  color       String?
  storage     String?
  quantity    Int           @default(0)
  buyPrice    Decimal
  sellPrice   Decimal
  lowStockAt  Int           @default(3)
  warrantyDays Int          @default(0)
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  saleItems         SaleItem[]
  purchaseOrderItems PurchaseOrderItem[]
  repairParts       RepairPart[]
  tradeInSource     TradeIn?  @relation("TradeInToInventory")

  @@index([type])
  @@index([barcode])
  @@index([imei])
}

// ─────────────────────────────────────────
// REPAIR FLOW — STAGE 1: CHECK-IN
// ─────────────────────────────────────────

model CheckIn {
  id            String    @id @default(cuid())
  checkInNumber String    @unique
  customerId    String
  customer      Customer  @relation(fields: [customerId], references: [id])
  createdById   String
  createdBy     User      @relation(fields: [createdById], references: [id])

  deviceBrand   String
  deviceModel   String
  imei          String?
  color         String?
  issueDesc     String
  condition     String?

  printedAt     DateTime?
  convertedAt   DateTime?
  repairTicket  RepairTicket?

  createdAt     DateTime  @default(now())

  @@index([checkInNumber])
}

// ─────────────────────────────────────────
// REPAIR FLOW — STAGE 2: FULL TICKET
// ─────────────────────────────────────────

enum TicketStatus {
  DIAGNOSING
  WAITING_PARTS
  IN_REPAIR
  DONE
  DELIVERED
  CANCELLED
}

enum Priority {
  LOW
  NORMAL
  URGENT
}

model RepairTicket {
  id             String       @id @default(cuid())
  ticketNumber   String       @unique
  checkInId      String?      @unique
  checkIn        CheckIn?     @relation(fields: [checkInId], references: [id])
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id])
  createdById    String
  createdBy      User         @relation(fields: [createdById], references: [id])

  deviceBrand    String
  deviceModel    String
  imei           String?
  devicePassword String?
  color          String?
  condition      String?

  issueDesc      String
  diagnosis      String?
  partsUsedNotes String?

  status         TicketStatus @default(DIAGNOSING)
  priority       Priority     @default(NORMAL)

  estimatedCost  Decimal?
  finalCost      Decimal?
  partsCost      Decimal?     @default(0)
  deposit        Decimal?     @default(0)

  warrantyDays   Int          @default(5)

  repairmanId    String?
  repairman      Repairman?   @relation(fields: [repairmanId], references: [id])
  repairmanPay   Decimal?     // his share: typed by hand, or computed from his rule when delivered

  receivedAt     DateTime     @default(now())
  estimatedDoneAt DateTime?
  deliveredAt    DateTime?
  updatedAt      DateTime     @updatedAt

  deposits       RepairDeposit[]
  parts          RepairPart[]
  warrantyClaims WarrantyClaim[] @relation("TicketWarrantyClaims")
  warrantyClaimNewTicket WarrantyClaim? @relation("ClaimNewTicket")
  debtEntry      DebtEntry?
  sale           Sale?

  @@index([status])
  @@index([ticketNumber])
  @@index([imei])
}

// Cash received (or refunded, negative) as a repair deposit, dated for the daily close
model RepairDeposit {
  id             String       @id @default(cuid())
  repairTicketId String
  repairTicket   RepairTicket @relation(fields: [repairTicketId], references: [id])
  amount         Decimal
  paidAt         DateTime     @default(now())

  @@index([paidAt])
}

// Part taken from stock for a repair; its cost is added to the ticket's partsCost
model RepairPart {
  id              String        @id @default(cuid())
  repairTicketId  String
  repairTicket    RepairTicket  @relation(fields: [repairTicketId], references: [id])
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  quantity        Int
  unitCost        Decimal
  createdAt       DateTime      @default(now())

  @@index([repairTicketId])
}

// ─────────────────────────────────────────
// WARRANTY CLAIMS
// ─────────────────────────────────────────

model WarrantyClaim {
  id               String        @id @default(cuid())
  originalTicketId String
  originalTicket   RepairTicket  @relation("TicketWarrantyClaims", fields: [originalTicketId], references: [id])

  issueDesc        String
  isWithinWarranty Boolean
  responsibleNote  String?

  newTicketId      String?       @unique
  newTicket        RepairTicket? @relation("ClaimNewTicket", fields: [newTicketId], references: [id])

  resolution       String?
  createdAt        DateTime      @default(now())
}

// ─────────────────────────────────────────
// TRADE-INS
// ─────────────────────────────────────────

enum TradeInCondition {
  EXCELLENT
  GOOD
  FAIR
  POOR
  BROKEN
}

enum TradeInStatus {
  APPRAISED
  ACCEPTED
  REJECTED
}

model TradeIn {
  id              String            @id @default(cuid())
  customerId      String
  customer        Customer          @relation(fields: [customerId], references: [id])

  brand           String
  model           String
  imei            String?
  storage         String?
  color           String?
  condition       TradeInCondition?
  conditionNotes  String?

  appraisedValue  Decimal
  payoutMethod    String            @default("CASH") // CASH = paid out of the drawer, STORE_CREDIT = deducted from a sale
  status          TradeInStatus     @default(APPRAISED)

  inventoryItemId String?           @unique
  inventoryItem   InventoryItem?    @relation("TradeInToInventory", fields: [inventoryItemId], references: [id])

  saleId          String?
  sale            Sale?             @relation(fields: [saleId], references: [id])

  createdAt       DateTime          @default(now())
}

// ─────────────────────────────────────────
// SALES & INVOICES
// ─────────────────────────────────────────

enum SaleStatus {
  COMPLETED
  CREDIT
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  CREDIT
  SPLIT
}

model Sale {
  id            String        @id @default(cuid())
  saleNumber    String        @unique
  customerId    String?
  customer      Customer?     @relation(fields: [customerId], references: [id])
  createdById   String
  createdBy     User          @relation(fields: [createdById], references: [id])

  status        SaleStatus    @default(COMPLETED)
  paymentMethod PaymentMethod @default(CASH)

  subtotal      Decimal
  discountAmount Decimal      @default(0)
  tradeInCredit Decimal       @default(0)
  total         Decimal
  amountPaid    Decimal
  change        Decimal       @default(0)
  creditAmount  Decimal       @default(0)
  depositApplied Decimal      @default(0) // part of amountPaid that was a repair deposit collected earlier

  repairTicketId String?      @unique
  repairTicket  RepairTicket? @relation(fields: [repairTicketId], references: [id])

  items         SaleItem[]
  tradeIns      TradeIn[]
  debtEntry     DebtEntry?
  refund        Refund?

  notes         String?
  createdAt     DateTime      @default(now())

  @@index([createdAt])
  @@index([status])
}

model SaleItem {
  id              String         @id @default(cuid())
  saleId          String
  sale            Sale           @relation(fields: [saleId], references: [id])
  inventoryItemId String?
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id])
  description     String         @default("")

  quantity        Int
  unitCost        Decimal        @default(0)
  unitPrice       Decimal
  subtotal        Decimal
  warrantyDays    Int           @default(0)
}

// Full refund of a sale, counted on the day it happens (the original sale stays on its own day)
model Refund {
  id          String   @id @default(cuid())
  saleId      String   @unique
  sale        Sale     @relation(fields: [saleId], references: [id])
  amount      Decimal  // money handed back to the customer
  revenue     Decimal  // sale total reversed
  cost        Decimal  // cost of the items put back in stock
  reason      String?
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

// ─────────────────────────────────────────
// EXPENSES
// ─────────────────────────────────────────

enum ExpenseCategory {
  SUPPLIER_RESTOCK
  RENT
  UTILITIES
  TOOLS_EQUIPMENT
  PETTY_CASH
  OTHER
}

model Expense {
  id          String          @id @default(cuid())
  category    ExpenseCategory
  description String
  amount      Decimal
  paidTo      String?
  supplierId  String?
  createdById String
  createdBy   User            @relation(fields: [createdById], references: [id])
  expenseDate DateTime        @default(now())
  createdAt   DateTime        @default(now())

  @@index([expenseDate])
  @@index([category])
}

// ─────────────────────────────────────────
// DAILY CLOSE SNAPSHOT
// ─────────────────────────────────────────

model DailyClose {
  id                 String   @id @default(cuid())
  date               DateTime @unique

  totalRevenue       Decimal
  totalCreditSales   Decimal
  totalDebtCollected Decimal
  totalExpenses      Decimal
  netCash            Decimal

  openTickets        Int
  doneNotDelivered   Int
  newWarrantyClaims  Int

  lowStockCount      Int
  openingCash        Decimal  @default(0) // money put in the drawer at the start of the day
  notes              String?
  closedAt           DateTime @default(now())
}
